# ==========================================
# PDF Handling Rules
# ==========================================
# Ignore all PDF files by default (so generated/temporary PDFs are not tracked)
*.pdf
**/*.pdf

# EXCEPTION: Do NOT ignore the sample PDFs
!backend/sample_complaints/*.pdf
!**/sample_complaints/*.pdf
